{
  "name": "@contraponha/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf build .turbo"
  },
  "dependencies": {
    "@contraponha/config": "workspace:*",
    "@contraponha/i18n": "workspace:*",
    "@contraponha/types": "workspace:*",
    "@contraponha/validation": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@contraponha/tsconfig": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
