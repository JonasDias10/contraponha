{
  "name": "@contraponha/web-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "build",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf build .turbo"
  },
  "dependencies": {
    "@contraponha/api-client": "workspace:*",
    "@contraponha/client-core": "workspace:*",
    "@contraponha/i18n": "workspace:*",
    "@contraponha/types": "workspace:*",
    "@contraponha/validation": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@contraponha/tsconfig": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "~19.2.18",
    "react": "19.2.3",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "19.2.3"
  }
}
