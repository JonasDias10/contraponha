{
  "name": "@contraponha/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./build/*"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --enable-source-maps --env-file-if-exists=../../.env --import ./build/instrument.js build/main.js\"",
    "start": "node --enable-source-maps --import ./build/instrument.js build/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf build .turbo",
    "users:set-role": "node --env-file-if-exists=../../.env build/scripts/set-user-role.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@contraponha/client-core": "workspace:*",
    "@contraponha/config": "workspace:*",
    "@contraponha/database": "workspace:*",
    "@contraponha/i18n": "workspace:*",
    "@contraponha/types": "workspace:*",
    "@contraponha/validation": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.1",
    "@sentry/nestjs": "~11.6.0",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "htmlparser2": "^12.0.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "10.0.14",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "~0.35.5",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@contraponha/tsconfig": "workspace:*",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
