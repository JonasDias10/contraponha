# Base URL of the Contraponha API, used by server components and the /api/v1 proxy.
API_URL=http://localhost:3000

# Public URL of the web app, for links to posts and profiles.
NEXT_PUBLIC_WEB_URL=http://localhost:3001

# Error and performance monitoring (public DSN). Leave empty to send nothing.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
