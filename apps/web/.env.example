# Base URL of the Contraponha API, used by server components.
API_URL=http://localhost:3000

# Public URL of the hub (moderation and admin), linked from the menu for moderators.
NEXT_PUBLIC_HUB_URL=http://localhost:3002

# Error and performance monitoring (public DSN). Leave empty to send nothing.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Public address of the site, used for absolute URLs in link previews (Open Graph).
SITE_URL=http://localhost:3001

# Cloudflare Turnstile site key for sign-up (pair with TURNSTILE_SECRET_KEY on the API).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Addresses shown in the legal pages (privacy, terms, transparency).
LEGAL_DPO_EMAIL=
LEGAL_CONTACT_EMAIL=
LEGAL_TRANSPARENCY_EMAIL=

# Universal links (iOS) and app links (Android): links to the site open in the mobile app.
# Apple Developer team id, and the SHA-256 fingerprints of the Android signing certificates
# (comma-separated; EAS shows them with `eas credentials`). Leave empty to serve nothing.
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=
