# Base URL of the Contraponha API.
# iOS simulator: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: http://<your-computer-lan-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public URL of the web app, used for share links and legal pages.
EXPO_PUBLIC_WEB_URL=http://localhost:3001

# Public URL of the hub (moderation and admin), linked from settings for moderators.
EXPO_PUBLIC_HUB_URL=http://localhost:3002

# Error and performance monitoring (public DSN). Leave empty to send nothing.
EXPO_PUBLIC_SENTRY_DSN=

# Turn on when the API has TURNSTILE_SECRET_KEY: sign-up shows the web app's human check.
EXPO_PUBLIC_TURNSTILE_ENABLED=false
