{
  "expo": {
    "name": "Contraponha",
    "slug": "contraponha",
    "scheme": "contraponha",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.contraponha.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.contraponha.mobile"
    },
    "plugins": ["expo-router", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
