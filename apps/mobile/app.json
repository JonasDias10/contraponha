{
  "expo": {
    "name": "Ponto",
    "slug": "ponto",
    "scheme": "ponto",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.ponto.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.ponto.mobile"
    },
    "plugins": ["expo-router", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
