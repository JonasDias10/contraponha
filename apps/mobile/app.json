{
  "expo": {
    "name": "Contraponha",
    "slug": "contraponha",
    "scheme": "contraponha",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "app.contraponha.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.contraponha.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fbfbfa"
      }
    },
    "plugins": ["expo-router", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
