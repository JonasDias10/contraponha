{
  "name": "contraponha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@contraponha/api --filter=@contraponha/web --filter=@contraponha/hub",
    "dev:api": "turbo run dev --filter=@contraponha/api",
    "dev:web": "turbo run dev --filter=@contraponha/web",
    "dev:hub": "turbo run dev --filter=@contraponha/hub",
    "dev:mobile": "turbo run build --filter=@contraponha/mobile^... && pnpm --filter @contraponha/mobile dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:browser": "turbo run build --filter=@contraponha/browser-tests^... && pnpm --filter @contraponha/browser-tests test:browser",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @contraponha/database db:generate",
    "db:migrate": "pnpm --filter @contraponha/database db:migrate",
    "db:studio": "pnpm --filter @contraponha/database db:studio",
    "users:set-role": "turbo run build --filter=@contraponha/api && pnpm --filter @contraponha/api users:set-role",
    "db:reconcile-counters": "turbo run build --filter=@contraponha/database && pnpm --filter @contraponha/database reconcile-counters",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo"
  },
  "devDependencies": {
    "@contraponha/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
