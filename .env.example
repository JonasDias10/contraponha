# Copy this file to .env and adjust it to your environment.
# Never put real secrets here: this file is committed.

# Application
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL (required)
# These values match docker-compose.yml.
DATABASE_URL=postgres://ponto:ponto@localhost:5432/ponto
DATABASE_POOL_MAX=10

# Redis (required)
# Use rediss:// for TLS connections.
REDIS_URL=redis://localhost:6379

# HTTP and security
# Comma-separated origins allowed by CORS. Empty disables CORS.
CORS_ORIGINS=http://localhost:3001
# Number of trusted proxies in front of the API (0 = direct access).
# Required for rate limiting to see the real client IP behind a load balancer.
TRUST_PROXY=0
# Default rate limit window and max requests per IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# OpenAPI docs at /api/docs. Default: enabled outside production.
SWAGGER_ENABLED=true

# Internationalization
DEFAULT_LOCALE=pt-BR
SUPPORTED_LOCALES=pt-BR,en,es

# Docker Compose (optional)
# Read only by docker-compose.yml. If you change them, update DATABASE_URL/REDIS_URL.
POSTGRES_USER=ponto
POSTGRES_PASSWORD=ponto
POSTGRES_DB=ponto
POSTGRES_PORT=5432
REDIS_PORT=6379
