# Copy this file to .env and adjust it to your environment.
# Never put real secrets here: this file is committed.

# Application
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL (required)
# These values match docker-compose.yml.
DATABASE_URL=postgres://ponto:ponto@localhost:5432/ponto
DATABASE_POOL_MAX=10

# Redis (required)
# Use rediss:// for TLS connections.
REDIS_URL=redis://localhost:6379

# HTTP and security
# Comma-separated origins allowed by CORS. Empty disables CORS.
CORS_ORIGINS=http://localhost:3001
# Number of trusted proxies in front of the API (0 = direct access).
# Required for rate limiting to see the real client IP behind a load balancer.
TRUST_PROXY=0
# Default rate limit window and max requests per IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# OpenAPI docs at /api/docs. Default: enabled outside production.
SWAGGER_ENABLED=true

# Accounts and sessions
# Public URL of the web app, used in email links (verification, password reset).
WEB_APP_URL=http://localhost:3001
SESSION_TTL_DAYS=30
# Stricter limit per IP for login, register and password endpoints.
AUTH_RATE_LIMIT_TTL_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Email (SMTP)
# Defaults point to Mailpit from docker-compose.yml; open http://localhost:8025 to read emails.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Ponto <no-reply@ponto.local>

# Media storage (any S3-compatible provider)
# Defaults point to RustFS from docker-compose.yml.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ponto-media
STORAGE_ACCESS_KEY_ID=ponto
STORAGE_SECRET_ACCESS_KEY=ponto-local-secret
STORAGE_FORCE_PATH_STYLE=true
# Creates the bucket with public read access on startup. Local development and CI only.
STORAGE_AUTO_CREATE_BUCKET=true
# Public base URL that serves stored media (a CDN in production).
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/ponto-media

# Internationalization
DEFAULT_LOCALE=pt-BR
SUPPORTED_LOCALES=pt-BR,en,es

# Docker Compose (optional)
# Read only by docker-compose.yml. If you change them, update DATABASE_URL/REDIS_URL.
POSTGRES_USER=ponto
POSTGRES_PASSWORD=ponto
POSTGRES_DB=ponto
POSTGRES_PORT=5432
REDIS_PORT=6379
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
